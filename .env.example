# Copy to .env and fill in every change-me, REGION and PROJECT_REF: cp .env.example .env
# Production differs in the lines marked "Production".

# Local development: also load docker-compose.local.yml, which reaches the auth server's dev Keycloak on
# localhost:8080. Production: delete this line.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Database: Supabase Postgres ---
# Dashboard → Connect → Session pooler, JDBC flavour, without the user/password query params.
# Not the Transaction pooler (port 6543): it breaks the JDBC driver's server-side prepared
# statements. Not the direct connection either: it is IPv6-only, which Docker networks lack.
SUPABASE_JDBC_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Pooler usernames carry the project ref.
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=change-me

# --- Login: the shared Keycloak, realm myapps (docs/auth.md) ---
# Must equal the "iss" claim of the tokens, character for character.
# Production: https://auth.finance-nl.com/realms/myapps
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/myapps
KEYCLOAK_CLIENT_ID=finance-tracker
# The dev value from the auth server's realm-export.json. Production: generated by Keycloak; copy it from
# Clients → finance-tracker → Credentials, and keep it out of git.
KEYCLOAK_CLIENT_SECRET=finance-tracker-secret

# --- App ---
FRONTEND_PORT=3000
# Local development only: the backend's port on the host (docker-compose.local.yml); 8080 is Keycloak's.
BACKEND_PORT=8081
