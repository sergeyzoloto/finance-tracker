# Copy to .env and fill in every change-me, REGION and PROJECT_REF: cp .env.example .env

# --- Database: Supabase Postgres, shared by the backend and Keycloak (schema "keycloak") ---
# Dashboard → Connect → Session pooler, JDBC flavour, without the user/password query params.
# Not the Transaction pooler (port 6543): it breaks the JDBC driver's server-side prepared
# statements. Not the direct connection either: it is IPv6-only, which Docker networks lack.
SUPABASE_JDBC_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Pooler usernames carry the project ref.
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=change-me

# --- Keycloak ---
# Bootstrap admin of the master realm; admin console at http://localhost:8180/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8180
# Public URL browsers use to reach Keycloak; it becomes the host part of the token issuer.
KEYCLOAK_URL=http://localhost:${KEYCLOAK_PORT}

# --- Social login, brokered by Keycloak ---
# How to obtain these: infra/keycloak/README.md. Imported into the realm on first start only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Backend ---
# Must equal the "iss" claim of access tokens, i.e. the realm URL as browsers see it.
JWT_ISSUER_URL=${KEYCLOAK_URL}/realms/finance-tracker

# --- Frontend ---
FRONTEND_PORT=3000
# Origins the realm's frontend client may redirect to: the compose frontend and the Vite dev
# server run on the host (npm run dev). Where there is no dev server, repeat FRONTEND_URL.
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
FRONTEND_DEV_URL=http://localhost:5173
