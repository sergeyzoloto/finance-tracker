# Copy to .env: cp .env.example .env. The values below work with the auth server's dev stack as they are.
# For local runs only. Production has its own stack: deploy/app/docker-compose.yml and deploy/RUNBOOK.md.

# Local development: also load docker-compose.local.yml, which reaches the auth server's dev Keycloak on
# localhost:8080.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Database: a local PostgreSQL container (docker-compose.yml), with its data in a named volume ---
# Both are optional. The port is the one on 127.0.0.1 where the backend and your tools reach it; 5432 may be taken.
LOCAL_DB_PORT=5433
LOCAL_DB_PASSWORD=finance-local

# --- Login: the shared Keycloak, realm myapps (docs/auth.md) ---
# Must equal the "iss" claim of the tokens, character for character.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/myapps
KEYCLOAK_CLIENT_ID=finance-tracker
# The dev value from the auth server's realm-export.json.
KEYCLOAK_CLIENT_SECRET=finance-tracker-secret

# --- App ---
FRONTEND_PORT=3000
# Local development only: the backend's port on the host (docker-compose.local.yml); 8080 is Keycloak's.
BACKEND_PORT=8081
