# Secrets of the production stack. On the server, deploy/RUNBOOK.md step 6 writes .env with generated values;
# .env is git-ignored and must stay readable by root only (chmod 600).
# Hex values only: a "$" would be read as a variable by Docker Compose.

# PostgreSQL's superuser "postgres", for maintenance. Nothing logs in with it over the network.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The app's own login "finance" (postgres-init.sh). Read once, when the database volume is created: changing it
# later needs ALTER ROLE finance PASSWORD as well.
# Generate: openssl rand -hex 24
APP_DB_PASSWORD=change-me

# Keycloak, realm myapps: Clients -> finance-tracker -> Credentials -> Client secret.
KEYCLOAK_CLIENT_SECRET=change-me
