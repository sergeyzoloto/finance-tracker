# Secrets of the production stack, as deploy/app/.env on the server only: deploy/RUNBOOK.md, "Write the secrets",
# writes it with generated passwords and the client secret typed in, never shown. .env is git-ignored; it stays
# readable by root only (mode 600). Hex and alphanumeric values only: Docker Compose reads a "$" as a variable.

# PostgreSQL's superuser "postgres", for maintenance. Nothing logs in with it over the network.
# Generated on the server: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The app's own login "finance" (postgres-init.sh). Read once, when the database volume is created: changing it later
# needs ALTER ROLE finance PASSWORD as well.
# Generated on the server: openssl rand -hex 24
APP_DB_PASSWORD=change-me

# Keycloak, realm myapps: Clients -> finance-tracker -> Credentials -> Client Secret.
KEYCLOAK_CLIENT_SECRET=change-me
