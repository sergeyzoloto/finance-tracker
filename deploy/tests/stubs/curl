#!/usr/bin/env bash
# Stub of curl for deploy/tests/run.sh: records the call, and answers
#   - GitHub's check runs from fixtures/ci.<n> (the n-th call) or fixtures/ci: a commit's (the gate up to OPS-3, which
#     the older scripts' cases run), or since OPS-3 a check suite's when fixtures/suite.<id> doesn't give that suite's;
#   - the runs of the workflow CI for a commit (since OPS-3) from fixtures/runs, or by default one run of
#     .github/workflows/ci.yml whose check suite is 101;
#   - the site's pages (https://app.finance-nl.com/…, F7b) with the body the deploy scripts look for and 200, or with
#     the status fixtures/pages gives the path ("<path> <status>" lines; any other status gets nginx's error page).
#     The body goes to -o's file and, with -w '%{http_code}', the status to stdout. Without -o the body goes to
#     stdout. A page with 200 is over 1 MB, with its text near the start (F7b): a reader that stops at the text, as
#     "curl | grep -q" does, closes the pipe long before the stub has written it all, which kills the stub with SIGPIPE
#     every time (no pipe holds 1 MB), as the real curl fails on it (exit 23).
# No network.
set -euo pipefail
S=${STUB_STATE:?}
printf 'curl %s\n' "$*" >>"$S/calls"
url=${*: -1}
case $url in
  https://api.github.com/repos/sergeyzoloto/finance-tracker/actions/workflows/ci.yml/runs\?head_sha=*\&per_page=100)
    if [ -f "$S/fixtures/runs" ]; then
      cat "$S/fixtures/runs"
    else
      printf '{"total_count": 1, "workflow_runs": [{"id": 1, "check_suite_id": 101, "path": ".github/workflows/ci.yml", "status": "completed"}]}\n'
    fi
    ;;
  https://api.github.com/repos/sergeyzoloto/finance-tracker/check-suites/*/check-runs\?per_page=100)
    id=${url#*/check-suites/}
    id=${id%%/*}
    if [ -f "$S/fixtures/suite.$id" ]; then
      cat "$S/fixtures/suite.$id"
    else
      n=$(($(cat "$S/count-ci" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$S/count-ci"
      f=$S/fixtures/ci
      [ -f "$f.$n" ] && f=$f.$n
      cat "$f"
    fi
    ;;
  https://api.github.com/repos/sergeyzoloto/finance-tracker/commits/*/check-runs\?per_page=100)
    n=$(($(cat "$S/count-ci" 2>/dev/null || echo 0) + 1))
    echo "$n" >"$S/count-ci"
    f=$S/fixtures/ci
    [ -f "$f.$n" ] && f=$f.$n
    cat "$f"
    ;;
  https://app.finance-nl.com/*)
    path=/${url#https://app.finance-nl.com/}
    out=/dev/stdout status_out=no
    while [ $# -gt 0 ]; do
      [ "$1" = -o ] && { out=$2; shift; }
      [ "$1" = -w ] && status_out=yes
      shift
    done
    status=200
    if [ -f "$S/fixtures/pages" ]; then
      status=$(awk -v p="$path" '$1 == p { s = $2 } END { print s ? s : 200 }' "$S/fixtures/pages")
    fi
    # ~1.4 MB of HTML comments, made once per case.
    filler=$S/page-filler
    [ -s "$filler" ] || awk 'BEGIN { for (i = 0; i < 20000; i++) printf "<!-- %06d filler after the text the checks look for -->\n", i }' >"$filler"
    if [ "$status" != 200 ]; then
      printf '<html><head><title>%s</title></head><body><center><h1>%s</h1></center><hr><center>nginx</center></body></html>\n' \
        "$status" "$status" >"$out"
    else
      {
        case $path in
          /) printf '<!doctype html><html><body><div id="root"></div>\n' ;;
          /privacy | /privacy.html) printf '<!doctype html><html><body><h1>Privacy policy</h1>\n' ;;
          *) printf 'an icon\n' ;;
        esac
        cat "$filler"
        printf '</body></html>\n'
      } >"$out"
    fi
    [ "$status_out" = no ] || printf '%s' "$status"
    ;;
  *) echo "curl stub: unexpected URL $url" >&2; exit 99 ;;
esac
