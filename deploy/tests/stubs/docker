#!/usr/bin/env bash
# Stub of docker for deploy/tests/run.sh: records every call in $STUB_STATE/calls and answers from $STUB_STATE, a
# fake image store and two fake containers. It never runs the real docker; an unknown call fails with 99.
#   images/<repo>/<tag>            an image ID per tag ("latest" for a bare repo name)
#   containers/<name>/image        the ID of the image the container runs
#   containers/<name>/started      its .State.StartedAt
#   containers/<name>/health       health states, one per line; each inspect takes the first, the last one stays
#   containers/<name>/env          its environment, KEY=value lines (holds a fake secret)
#   log-api                        the api's log, "<timestamp> <line>"
#   fixtures/                      what psql, a build and a start answer (deploy/tests/run.sh, setup_case); psql answers
#                                  only as finance_checks (or, with STUB_ALLOW_FINANCE=1, as OPS-1's finance)
# The image store (OPS-2, defect 4), from the file store: classic (the default), containerd, broken (no daemon: docker
# info and docker version fail), or unrecognised (docker info answers null). In the classic store an image's ID is its config digest, so its content identity is its ID, and a build of
# the same content (fixtures/same-content-<service>) keeps the ID. In the containerd store the ID is a manifest list's
# digest: a build gets a new ID every time, content/<hex of the ID> holds the content identity (the platform
# manifest's digest), a sha256 ID that no tag names (nor the file present) is gone, as there, even while a container
# runs it, and a container's ImageManifestDescriptor names its content (none with containers/<name>/no-descriptor).
# fixtures/no-platform makes docker version fail, so no content identity can be read. Compose recreates a container
# when its image's content changed, as its com.docker.compose.image label (the manifest's digest) does.
set -euo pipefail
S=${STUB_STATE:?}
printf 'docker %s\n' "$*" >>"$S/calls"

now() { date -u +%Y-%m-%dT%H:%M:%S.%NZ; }
NO_DAEMON='failed to connect to the docker API at unix:///var/run/docker.sock; check if the path is correct and if the daemon is running: dial unix /var/run/docker.sock: connect: no such file or directory'
new_id() { printf 'sha256:%s' "$(head -c 32 /dev/urandom | sha256sum | cut -c1-64)"; }

# next_fixture NAME: fixtures/NAME.<n> for the n-th call of NAME, else fixtures/NAME.
next_fixture() {
  local n=0
  [ -f "$S/count-$1" ] && n=$(cat "$S/count-$1")
  n=$((n + 1))
  echo "$n" >"$S/count-$1"
  if [ -f "$S/fixtures/$1.$n" ]; then echo "$S/fixtures/$1.$n"; else echo "$S/fixtures/$1"; fi
}

store() { cat "$S/store" 2>/dev/null || echo classic; }

# present ID: the containerd store still holds the ID (a tag names it, or the file present lists it).
present() {
  [ "$(store)" != containerd ] && return 0
  grep -rqxF -- "$1" "$S/images" 2>/dev/null || grep -qxF -- "$1" "$S/present" 2>/dev/null
}

# content_of ID: the content identity of an image ID.
content_of() {
  if [ "$(store)" = containerd ]; then
    cat "$S/content/${1#sha256:}" 2>/dev/null || return 1
  else
    echo "$1"
  fi
}

resolve() {
  local ref=$1 repo tag
  if [[ $ref == sha256:* ]]; then
    present "$ref" || { echo "Error response from daemon: No such image: $ref" >&2; return 1; }
    echo "$ref"
    return
  fi
  repo=${ref%%:*}
  tag=latest
  [[ $ref == *:* ]] && tag=${ref#*:}
  [ -f "$S/images/$repo/$tag" ] || { echo "Error response from daemon: No such image: $ref" >&2; return 1; }
  cat "$S/images/$repo/$tag"
}

container() {
  [ -d "$S/containers/$1" ] || { echo "Error: No such object: $1" >&2; exit 1; }
}

inspect() {
  local template=$3 name=$4 f
  container "$name"
  case $template in
    '{{.Image}}') cat "$S/containers/$name/image" ;;
    '{{with .ImageManifestDescriptor}}{{.Digest}}{{end}}')
      if [ "$(store)" = containerd ] && [ ! -e "$S/containers/$name/no-descriptor" ]; then
        content_of "$(cat "$S/containers/$name/image")" || true
      fi
      ;;
    '{{.State.StartedAt}}') cat "$S/containers/$name/started" ;;
    '{{.State.Health.Status}}')
      f=$S/containers/$name/health
      head -n 1 "$f"
      if [ "$(wc -l <"$f")" -gt 1 ]; then sed -i 1d "$f"; fi
      ;;
    *.Config.Env*FAMILY_LEDGERS_ENABLED*)
      # What the real template prints: that one variable, or nothing.
      grep '^FAMILY_LEDGERS_ENABLED=' "$S/containers/$name/env" || true
      ;;
    *.Config.Env*) cat "$S/containers/$name/env" ;;   # the whole environment, secret included
    *) echo "docker stub: unknown inspect template: $template" >&2; exit 99 ;;
  esac
}

psql_call() {
  local args=$* sql f from
  [[ $args == *"PGOPTIONS=-c default_transaction_read_only=on"* ]] \
    || { echo "docker stub: psql without default_transaction_read_only=on: $args" >&2; exit 97; }
  # Since F6b every check runs as the read-only role; OPS-1's scripts, which a case runs as the server had them, ran as
  # the app's login (STUB_ALLOW_FINANCE=1).
  if [[ $args != *" -U finance_checks "* ]] && ! { [ "${STUB_ALLOW_FINANCE:-}" = 1 ] && [[ $args == *" -U finance "* ]]; }; then
    echo "docker stub: psql not as finance_checks: $args" >&2
    exit 97
  fi
  if [[ $args == *pg_read_all_data* ]]; then
    # The role as it reads itself (fixtures/role), or "missing": psql can't log in.
    f=$(next_fixture role)
    if [ "$(cat "$f")" = missing ]; then
      echo 'psql: error: connection to server on socket "/var/run/postgresql/.s.PGSQL.5432" failed: FATAL:  role "finance_checks" does not exist' >&2
      exit 2
    fi
    cat "$f"
    return
  fi
  if [[ $args == *" -f -"* ]]; then
    sql=$(cat)
    case $sql in
      *"'outside_their_ledger'"*)
        f=$(next_fixture numbers)
        # fixtures/numbers-fails: the numbers can't be read, from its n-th call on (any call when it is empty; D-50).
        from=$(cat "$S/fixtures/numbers-fails" 2>/dev/null || echo none)
        if [ "$from" != none ] && { [ -z "$from" ] || [ "$(cat "$S/count-numbers")" -ge "$from" ]; }; then
          echo 'ERROR:  permission denied for table users' >&2
          exit 1
        fi
        ;;
      *"'flyway latest '"*) f=$(next_fixture stage) ;;
      *) echo "docker stub: unknown SQL file" >&2; exit 99 ;;
    esac
  else
    case $args in
      *flyway_schema_history*) f=$(next_fixture flyway) ;;
      *app.family_record*) f=$(next_fixture family_records) ;;
      *) echo "docker stub: unknown query: $args" >&2; exit 99 ;;
    esac
  fi
  cat "$f"
}

up() {
  # fixtures/up-fails: compose fails before it touches a container (OPS-2, defect 1's interrupted switch).
  [ ! -f "$S/fixtures/up-fails" ] || { echo "up failed (stub)" >&2; exit 1; }
  # Services named on the command line (api, web); both when none are, as every real call here names at least one.
  local svc name id line want_switch cur_switch d25 services=() image_changed env_changed
  for svc in "$@"; do
    case $svc in
      -*) ;;
      *) services+=("$svc") ;;
    esac
  done
  [ ${#services[@]} -gt 0 ] || services=(api web)
  # What ./.env (deploy/app/.env, the real compose project's) says now: compose always runs from there (common.sh).
  want_switch=$(grep '^FAMILY_LEDGERS_ENABLED=' ./.env 2>/dev/null || true)
  for svc in "${services[@]}"; do
    name=finance-tracker-$svc
    id=$(cat "$S/images/$name/latest")
    image_changed=0
    [ "$(content_of "$id" || echo "$id")" = "$(content_of "$(cat "$S/containers/$name/image")" || echo none)" ] \
      || image_changed=1
    env_changed=0
    if [ "$svc" = api ]; then
      cur_switch=$(grep '^FAMILY_LEDGERS_ENABLED=' "$S/containers/$name/env" 2>/dev/null || true)
      [ "$want_switch" = "$cur_switch" ] || env_changed=1
    fi
    [ "$image_changed" = 1 ] || [ "$env_changed" = 1 ] || continue   # Compose leaves an unchanged container running
    echo "$id" >"$S/containers/$name/image"
    now >"$S/containers/$name/started"
    cp "$S/fixtures/health-$svc" "$S/containers/$name/health"
    if [ "$svc" != api ]; then
      : # web has no switch line to carry
    elif [ "$env_changed" = 1 ] && [ "$image_changed" = 0 ]; then
      # Only the switch recreated api, with the same image: update its recorded env and the log's D-25 line to match
      # .env, as the real api would log on the new value. A plain deploy (the image changed) below keeps using the
      # fixture's start-log and env exactly as the case set them, D-25 line included: a case may set them to anything,
      # consistent or not with FAMILY_LEDGERS_ENABLED, to test the api's own line against what's expected.
      grep -v '^FAMILY_LEDGERS_ENABLED=' "$S/containers/$name/env" >"$S/containers/$name/env.new" || true
      [ -z "$want_switch" ] || printf '%s\n' "$want_switch" >>"$S/containers/$name/env.new"
      mv "$S/containers/$name/env.new" "$S/containers/$name/env"
      case ${want_switch#FAMILY_LEDGERS_ENABLED=} in
        true | on | yes | 1) d25='Family ledgers (D-25): on' ;;
        *) d25='Family ledgers (D-25): off; the family endpoints answer 404' ;;
      esac
      while IFS= read -r line; do
        case $line in
          *'Family ledgers (D-25):'*) line=$d25 ;;
        esac
        printf '%s %s\n' "$(now)" "$line" >>"$S/log-api"
      done <"$S/fixtures/start-log"
    else
      while IFS= read -r line; do printf '%s %s\n' "$(now)" "$line" >>"$S/log-api"; done <"$S/fixtures/start-log"
    fi
    echo " Container $name  Started"
  done
}

logs() {
  local since=''
  while [ $# -gt 0 ]; do
    case $1 in
      --since) since=$2; shift ;;
    esac
    shift
  done
  awk -v since="$since" 'since == "" || $1 >= since' "$S/log-api"
}

# build SERVICE: a new :latest. The same content (fixtures/same-content-<service>) keeps the ID in the classic store and
# gets a new ID with the same content identity in the containerd store; other content gets a new ID and content.
build() {
  local f=$S/images/finance-tracker-$1/latest old id
  old=$(cat "$f")
  if [ -e "$S/fixtures/same-content-$1" ] && [ "$(store)" != containerd ]; then return 0; fi
  id=$(new_id)
  if [ "$(store)" = containerd ]; then
    mkdir -p "$S/content"
    if [ -e "$S/fixtures/same-content-$1" ]; then
      content_of "$old" >"$S/content/${id#sha256:}"
    else
      new_id >"$S/content/${id#sha256:}"
    fi
  fi
  echo "$id" >"$f"
}

compose() {
  case $1 in
    version) echo "Docker Compose version v2.40.0 (stub)" ;;
    build)
      [ -f "$S/fixtures/build-fails" ] && { echo "build failed (stub)" >&2; exit 1; }
      [ -x "$S/fixtures/on-build" ] && "$S/fixtures/on-build"
      build "$2"
      echo " Image finance-tracker-$2 Built"
      ;;
    up) shift; up "$@" ;;
    ps) printf 'NAME\tSTATUS\nfinance-tracker-api\tUp (%s)\nfinance-tracker-web\tUp (healthy)\n' "$(head -n 1 "$S/containers/finance-tracker-api/health")" ;;
    logs) shift; logs "$@" ;;
    exec) shift; psql_call "$@" ;;
    config) cat "$S/containers/finance-tracker-api/env" ;;   # the real one prints the secrets too
    *) echo "docker stub: unknown compose command: $*" >&2; exit 99 ;;
  esac
}

case $1 in
  compose) shift; compose "$@" ;;
  info)
    # Byte for byte as Docker answers (OPS-2b): containerd as production's 29.8.2 (2026-10-04's pre-flight) and a
    # docker:29-dind of 29.8.2; classic as the laptop's 29.8.1 with overlay2; broken as the 29.x client without a
    # daemon (null, then the error, exit 1); unrecognised a daemon that answers what the scripts can't parse.
    [ $# -eq 3 ] && [ "$2 $3" = "-f {{json .DriverStatus}}" ] || exit 99
    case $(store) in
      containerd) echo '[["driver-type","io.containerd.snapshotter.v1"]]' ;;
      classic) echo '[["Backing Filesystem","extfs"],["Supports d_type","true"],["Using metacopy","false"],["Native Overlay Diff","true"],["userxattr","false"]]' ;;
      unrecognised) echo null ;;
      *) echo null; echo "$NO_DAEMON" >&2; exit 1 ;;
    esac
    ;;
  version)
    [ $# -eq 3 ] && [ "$2 $3" = "-f {{.Server.Os}}/{{.Server.Arch}}" ] || exit 99
    [ ! -e "$S/fixtures/no-platform" ] || { echo "unknown flag (stub)" >&2; exit 1; }
    [ "$(store)" != broken ] || { echo; echo "$NO_DAEMON" >&2; exit 1; }
    echo linux/amd64
    ;;
  inspect) [ "$2" = -f ] || exit 99; inspect "$@" ;;
  image)
    case $2 in
      inspect)
        if [ "$3" = --platform ]; then
          [ "$4" = linux/amd64 ] && [ "$5" = -f ] && [ "$6" = '{{.Id}}' ] || exit 99
          [ ! -e "$S/fixtures/no-platform" ] || { echo "unknown flag: --platform (stub)" >&2; exit 1; }
          id=$(resolve "$7")
          content_of "$id" || { echo "Error response from daemon: no manifest for linux/amd64 (stub)" >&2; exit 1; }
        else
          [ "$3" = -f ] && [ "$4" = '{{.Id}}' ] || exit 99
          resolve "$5"
        fi
        ;;
      ls) [ "$3" = --format ] && [ "$4" = '{{.Tag}}' ] || exit 99; ls "$S/images/$5" 2>/dev/null || true ;;
      prune) echo "Total reclaimed space: 0B" ;;
      *) echo "docker stub: unknown image command: $*" >&2; exit 99 ;;
    esac
    ;;
  tag)
    id=$(resolve "$2")
    repo=${3%%:*} tag=latest
    [[ $3 == *:* ]] && tag=${3#*:}
    mkdir -p "$S/images/$repo"
    echo "$id" >"$S/images/$repo/$tag"
    ;;
  rmi)
    repo=${2%%:*} tag=${2#*:}
    rm "$S/images/$repo/$tag"
    echo "Untagged: $2"
    ;;
  exec) cat "$S/containers/finance-tracker-api/env" ;;   # docker exec … env or printenv would print the secret
  *) echo "docker stub: unknown command: $*" >&2; exit 99 ;;
esac
