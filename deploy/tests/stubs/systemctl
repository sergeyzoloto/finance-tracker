#!/usr/bin/env bash
# Stub of systemctl for deploy/tests/run.sh: records every call; "start pg-backup@finance.service" writes a fake dump
# and last-success into $DEPLOY_BACKUP_DIR, as the auth server's pg-backup does, unless fixtures/backup-fails exists.
# Each dump's bytes differ from the one before (its size grows by one), so their SHA-256 differ too. Its name:
#   - by default finance-<UTC minute>-<n>.dump, unique, so that no case waits for the next minute;
#   - with fixtures/dump-minute-names, finance-<UTC minute>.dump, as pg-backup names it: a second dump in the same
#     minute replaces the first, in place (D-43);
#   - with fixtures/dump-overwrite, every dump after the first rewrites the first one's file in place, the same inode.
set -euo pipefail
S=${STUB_STATE:?}
printf 'systemctl %s\n' "$*" >>"$S/calls"
if [ "$*" = "start pg-backup@finance.service" ]; then
  [ -f "$S/fixtures/backup-fails" ] && exit 1
  dir=${DEPLOY_BACKUP_DIR:?}
  n=$(($(cat "$S/count-backup" 2>/dev/null || echo 0) + 1))
  echo "$n" >"$S/count-backup"
  file=finance-$(date -u +%Y-%m-%dT%H%MZ)-$n.dump
  [ -f "$S/fixtures/dump-minute-names" ] && file=finance-$(date -u +%Y-%m-%dT%H%MZ).dump
  if [ -f "$S/fixtures/dump-overwrite" ] && [ -s "$S/first-dump" ]; then file=$(cat "$S/first-dump"); fi
  [ -s "$S/first-dump" ] || echo "$file" >"$S/first-dump"
  head -c $((1449000 + n)) /dev/zero >"$dir/$file"
  printf 'last_success=%s\nlast_success_epoch=%s\nfile=%s\nsize_bytes=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date +%s)" "$file" $((1449000 + n)) >"$dir/last-success"
fi
